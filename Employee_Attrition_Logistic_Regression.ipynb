   "source": [
    "# Select useful numerical columns for correlation checking\n",
    "corr_features = [\n",
    "    \"Age\", \"DailyRate\", \"DistanceFromHome\", \"Education\",\n",
    "    \"EnvironmentSatisfaction\", \"HourlyRate\", \"JobInvolvement\",\n",
    "    \"JobLevel\", \"JobSatisfaction\", \"MonthlyIncome\", \"MonthlyRate\",\n",
    "    \"NumCompaniesWorked\", \"PercentSalaryHike\", \"PerformanceRating\",\n",
    "    \"RelationshipSatisfaction\", \"StockOptionLevel\", \"TotalWorkingYears\",\n",
    "    \"TrainingTimesLastYear\", \"WorkLifeBalance\", \"YearsAtCompany\",\n",
    "    \"YearsInCurrentRole\", \"YearsSinceLastPromotion\", \"YearsWithCurrManager\"\n",
    "]\n",
    "\n",
    "# Calculate correlation matrix\n",
    "corr_matrix = df[corr_features].corr()\n",
    "\n",
    "# Identify strongly correlated pairs\n",
    "strong_corr = corr_matrix.where(\n",
    "    corr_matrix.abs() > 0.7\n",
    ").stack().reset_index()\n",
    "\n",
    "strong_corr.columns = [\n",
    "    \"Feature 1\", \"Feature 2\", \"Correlation\"\n",
    "]\n",
    "\n",
    "# Remove duplicate pairs and self-correlations\n",
    "strong_corr = strong_corr[\n",
    "    (strong_corr[\"Feature 1\"] < strong_corr[\"Feature 2\"])\n",
    "]\n",
    "\n",
    "print(\"Strongly correlated feature pairs (absolute correlation > 0.7):\")\n",
    "if strong_corr.empty:\n",
    "    print(\"No strongly correlated pairs were found.\")\n",
    "else:\n",
    "    print(strong_corr.to_string(index=False))"
   ]
  },
